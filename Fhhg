	if input.KeyCode == Enum.KeyCode.M then
		mainFrame.Visible = not mainFrame.Visible
	end
end)

----------------------------------------------------------------
-- [ส่วนที่ 2: ระบบคำนวณฟิสิกส์จุดตกบอลล่วงหน้า]
----------------------------------------------------------------
local function spawnLandingMarker(position)
	if not isPredictorEnabled then return end -- หากปิดระบบอยู่ จะไม่สปอว์นวงกลม

	local oldMarker = Workspace:FindFirstChild("InstantBallTarget")
	if oldMarker then oldMarker:Destroy() end

	local marker = Instance.new("Part")
	marker.Name = "InstantBallTarget"
	marker.Shape = Enum.PartType.Cylinder
	marker.Size = Vector3.new(0.2, 5, 5) 
	marker.Rotation = Vector3.new(0, 0, 90) 
	marker.Position = Vector3.new(position.X, FLOOR_HEIGHT + 0.05, position.Z)
	marker.Anchored = true
	marker.CanCollide = false
	marker.CanTouch = false
	marker.CanQuery = false
	marker.Material = Enum.Material.Neon
	marker.Color = Color3.fromRGB(255, 60, 60) 
	marker.Transparency = 0.4 
	marker.Parent = Workspace
	
	Debris:AddItem(marker, 3.5) -- ตั้งเวลาลบวงกลมออกหลังจาก 3.5 วินาที
end

local function predictInstantLanding(ball)
	local startPos = ball.Position
	local velocity = ball.AssemblyLinearVelocity 
	local gravity = Workspace.Gravity 
	
	if velocity.Magnitude < 5 then return end
	
	local a = -0.5 * gravity
	local b = velocity.Y
	local c = startPos.Y - FLOOR_HEIGHT
	local discriminant = (b * b) - (4 * a * c)
	
	if discriminant >= 0 then
		local t = (-b - math.sqrt(discriminant)) / (2 * a)
		if t > 0 then
			local finalX = startPos.X + (velocity.X * t)
			local finalZ = startPos.Z + (velocity.Z * t)
			local landingPosition = Vector3.new(finalX, FLOOR_HEIGHT, finalZ)
			
			spawnLandingMarker(landingPosition)
		end
	end
end

-- ลูปดักจับฟิสิกส์แรงปะทะลูกบอล
task.spawn(function()
	local lastVelocity = Vector3.zero
	while true do
		-- ดึงอ็อบเจกต์ลูกบอลใน Workspace (ตรวจจับทั้งชื่อ Ball หรือ Volleyball)
		local ball = Workspace:FindFirstChild(BALL_NAME) or Workspace:FindFirstChild("Volleyball")
		if ball and ball:IsA("BasePart") then
			local currentVelocity = ball.AssemblyLinearVelocity
			-- ตรวจจับแรงกระแทกเมื่อบอลเปลี่ยนทิศทางกะทันหัน
			if math.abs(currentVelocity.Y - lastVelocity.Y) > 8 then
				RunService.Heartbeat:Wait()
				if isPredictorEnabled then
					predictInstantLanding(ball)
				end
			end
			lastVelocity = ball.AssemblyLinearVelocity
		end
		task.wait(0.05)
	end
end)

print("ระบบแก้ไขบั๊ก เมนู UI + Instant Ball Predictor พร้อมทำงานแล้ว!")
